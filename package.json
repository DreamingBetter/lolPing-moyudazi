{
  "name": "lolping-moyudazi",
  "productName": "lolPing-摸鱼搭子",
  "version": "0.6.0",
  "private": true,
  "description": "lolPing-moyudazi (lolPing-摸鱼搭子) is a Windows desktop app with League-style wheels, shortcuts, room chat, danmaku, cursor skins, and Heartsteel.",
  "author": "DreamingBetter",
  "license": "MIT",
  "homepage": "https://github.com/DreamingBetter/lolPing-moyudazi#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/DreamingBetter/lolPing-moyudazi.git"
  },
  "bugs": "https://github.com/DreamingBetter/lolPing-moyudazi/issues",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:helper": "node native/hook-helper/run.mjs build",
    "test:helper": "node native/hook-helper/run.mjs test",
    "dist": "npm run build:helper && electron-vite build && node tools/build-win.mjs",
    "dev:site": "vite --config site/vite.config.ts",
    "build:site": "vite build --config site/vite.config.ts",
    "media": "npm run build:site && electron tools/capture-media/capture.mjs"
  },
  "devDependencies": {
    "@fluentui/react-components": "9.74.9",
    "@fluentui/react-icons": "2.0.343",
    "@noble/secp256k1": "3.2.0",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "electron-updater": "6.8.10",
    "electron-vite": "5.0.0",
    "esbuild": "0.25.12",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "5.0.3",
    "ws": "8.22.0"
  },
  "build": {
    "appId": "com.dreamingbetter.lolping.moyudazi.windows",
    "productName": "lolPing-摸鱼搭子",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "extraResources": [
        {
          "from": "native/hook-helper/build/hook-helper.exe",
          "to": "hook-helper.exe"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "lolPing-moyudazi-Setup-${version}.exe",
      "include": "build/installer.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "DreamingBetter",
        "repo": "lolPing-moyudazi"
      }
    ]
  }
}
